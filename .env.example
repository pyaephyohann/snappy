[TEMPLATE]
[TEMPLATE]
[TEMPLATE]
DATABASE_URL="postgresql://USERNAME:PASSWORD@HOST:5432/DATABASE_NAME?sslmode=require"
AUTH_SECRET="replace-with-a-secure-random-secret-32-chars-minimum"

# Authentication
# Admin passcode opens the Admin App. Each app user has their own passcode (set in Admin → Users).
# Do NOT commit real passcodes to Git.
ADMIN_PASSCODE=""

# Admin Secret Route UUID
# This UUID is required to access the admin dashboard at /admin/<UUID>
# Generate with: node -e "console.log(require('crypto').randomUUID())"
ADMIN_SECRET_ROUTE_UUID=""

# Cloudinary Configuration
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME="your-cloud-name"
NEXT_PUBLIC_CLOUDINARY_API_KEY="your-api-key"
CLOUDINARY_API_SECRET="your-cloudinary-api-secret"
CLOUDINARY_UPLOAD_PRESET="snappy-uploads"

# Web Push (VAPID) — required for push notifications
# Generate keys: npx web-push generate-vapid-keys
# VAPID_SUBJECT must be a mailto: or https: URL (e.g. mailto:admin@example.com)
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:admin@example.com"

# Telegram Bot (server-only — never expose these to the client)
# Create a bot with @BotFather, then set the webhook with: npm run telegram:setup
TELEGRAM_BOT_TOKEN=""
TELEGRAM_WEBHOOK_SECRET=""
# Optional. HTTPS origin used by the "Open Snappy" button.
# If unset, production uses VERCEL_PROJECT_PRODUCTION_URL when available.
SNAPPY_PUBLIC_URL=""
# Optional. Full webhook URL. Defaults to ${SNAPPY_PUBLIC_URL}/api/telegram/webhook
TELEGRAM_WEBHOOK_URL=""
# Optional. Max age (seconds) for Telegram Mini App initData auth_date validation.
# Default: 3600 (1 hour). Minimum 60, maximum 86400.
TELEGRAM_INIT_DATA_MAX_AGE_SECONDS=""
