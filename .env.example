[TEMPLATE]
[TEMPLATE]
[TEMPLATE]
# Database (Neon Postgres)
# DATABASE_URL: pooled connection used by the app at runtime (Prisma Client).
# DIRECT_URL:  direct, non-pooled connection required by Prisma migrate/deploy
#              operations (schema engine), for example prisma migrate deploy.
# Both are server-only secrets: never prefix them with NEXT_PUBLIC_ and never
# commit real credentials. See docs/social.md and docs/telegram-release-checklist.md.
DATABASE_URL="postgresql://USERNAME:PASSWORD@HOST:5432/DATABASE_NAME?sslmode=require"
AUTH_SECRET="replace-with-a-secure-random-secret-32-chars-minimum"

# Authentication
# Admin passcode opens the Admin App. Each app user has their own passcode (set in Admin → Users).
# Do NOT commit real passcodes to Git.
ADMIN_PASSCODE=""

# Admin Secret Route UUID
# This UUID is required to access the admin dashboard at /admin/<UUID>
# Generate with: node -e "console.log(require('crypto').randomUUID())"
ADMIN_SECRET_ROUTE_UUID=""

# Cloudinary Configuration
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME="your-cloud-name"
NEXT_PUBLIC_CLOUDINARY_API_KEY="your-api-key"
CLOUDINARY_API_SECRET="your-cloudinary-api-secret"
CLOUDINARY_UPLOAD_PRESET="snappy-uploads"

# Web Push (VAPID) — required for push notifications
# Generate keys: npx web-push generate-vapid-keys
# VAPID_SUBJECT must be a mailto: or https: URL (e.g. mailto:admin@example.com)
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:admin@example.com"

# Payment provider (server-only — NEVER expose these to the client)
# Consumed by lib/payment/payment-config.ts (S7-B.1). Leave the secret empty:
# no real credential is ever committed. Do not create NEXT_PUBLIC_* copies.
# PAYMENT_ENVIRONMENT and PAYMENT_API_BASE_URL are validated as a matching pair:
#   production → https://payments.wavemoney.io        (no port)
#   test       → https://testpayments.wavemoney.io:8107
# A mismatch, or any other host/port, fails configuration validation.
PAYMENT_PROVIDER="wavepay"                    # only "wavepay" is accepted
PAYMENT_ENVIRONMENT=""                        # "test" | "production"
PAYMENT_MERCHANT_ID=""                        # merchant id issued by the provider
PAYMENT_MERCHANT_NAME=""                      # name shown on the provider payment screen
PAYMENT_MERCHANT_SECRET=""                    # HMAC secret issued by the provider (server-only)
PAYMENT_API_BASE_URL=""                       # HTTPS origin; must match PAYMENT_ENVIRONMENT

# Payment callback / return origins (server-only — NEVER use NEXT_PUBLIC_)
# Consumed by lib/payment/payment-urls.ts (S7-B.2). The request Host and the
# browser origin are never consulted; invalid explicit values fail closed (503).
# SNAPPY_PUBLIC_URL (documented under Telegram below) is the public HTTPS app
# origin. PAYMENT_CALLBACK_BASE_URL is optional: when set it becomes the
# dedicated callback origin, otherwise the callback origin defaults to
# SNAPPY_PUBLIC_URL. VERCEL_PROJECT_PRODUCTION_URL is a Vercel-provided
# host-only fallback used only when SNAPPY_PUBLIC_URL is unset — it is not a
# variable you set by hand.
PAYMENT_CALLBACK_BASE_URL=""                  # optional dedicated HTTPS callback origin

# Telegram Bot (server-only — never expose these to the client)
# Create a bot with @BotFather, then set the webhook with: npm run telegram:setup
# Required in production for webhook + Mini App auth
TELEGRAM_BOT_TOKEN=""
TELEGRAM_WEBHOOK_SECRET=""
# Optional. Public @username for Mini App → bot links (e.g. my_snappy_bot).
TELEGRAM_BOT_USERNAME=""
# Optional. HTTPS origin used by the "Open Snappy" button.
# If unset, production uses VERCEL_PROJECT_PRODUCTION_URL when available.
SNAPPY_PUBLIC_URL=""
# Optional. Full webhook URL. Defaults to ${SNAPPY_PUBLIC_URL}/api/telegram/webhook
TELEGRAM_WEBHOOK_URL=""
# Optional. Max age (seconds) for Telegram Mini App initData auth_date validation.
# Default: 3600 (1 hour). Minimum 60, maximum 86400.
TELEGRAM_INIT_DATA_MAX_AGE_SECONDS=""
