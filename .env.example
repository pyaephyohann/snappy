[TEMPLATE]
[TEMPLATE]
[TEMPLATE]
DATABASE_URL="postgresql://USERNAME:PASSWORD@HOST:5432/DATABASE_NAME?sslmode=require"
AUTH_SECRET="replace-with-a-secure-random-secret-32-chars-minimum"

# Authentication Passcodes
# These determine which application a user can access.
# Do NOT commit real passcodes to Git.
USER_PASSCODE=""
ADMIN_PASSCODE=""

# Admin Secret Route UUID
# This UUID is required to access the admin dashboard at /admin/<UUID>
# Generate with: node -e "console.log(require('crypto').randomUUID())"
ADMIN_SECRET_ROUTE_UUID=""

# Cloudinary Configuration
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME="your-cloud-name"
NEXT_PUBLIC_CLOUDINARY_API_KEY="your-api-key"
CLOUDINARY_API_SECRET="your-cloudinary-api-secret"
CLOUDINARY_UPLOAD_PRESET="snappy-uploads"
