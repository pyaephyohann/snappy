generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model AccessCredential {
  id           String   @id @default(cuid())
  passcodeHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("access_credentials")
}

model AdminCredential {
  id           String   @id @default(cuid())
  passcodeHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("admin_credentials")
}

model User {
  id                 String             @id @default(cuid())
  name               String             @unique
  profileImage       String
  profileImageSnapId String?            @unique
  passcodeHash       String?
  isActive           Boolean            @default(true)
  lastLoginAt        DateTime?
  role               UserRole           @default(USER)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  commentLikes       CommentLike[]
  comments           Comment[]
  reactions          Reaction[]
  snaps              Snap[]
  profileImageSnap   Snap?              @relation("UserProfileImage", fields: [profileImageSnapId], references: [id], onDelete: SetNull)
  telegramAccount    TelegramAccount?

  @@map("users")
}

model Snap {
  id                String             @id @default(cuid())
  imageUrl          String
  publicId          String
  caption           String?
  userId            String
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  comments          Comment[]
  reactions         Reaction[]
  heroCarouselSlide HeroCarouselSlide?
  user              User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  profileImageUser  User?              @relation("UserProfileImage")

  @@index([userId])
  @@index([createdAt])
  @@map("snaps")
}

model HeroCarouselConfig {
  id        String   @id @default("default")
  title     String?
  updatedAt DateTime @updatedAt

  @@map("hero_carousel_config")
}

model HeroCarouselSlide {
  id        String   @id @default(cuid())
  snapId    String   @unique
  sortOrder Int
  altText   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  snap      Snap     @relation(fields: [snapId], references: [id], onDelete: Cascade)

  @@index([sortOrder])
  @@map("hero_carousel_slides")
}

model Reaction {
  id        String   @id @default(cuid())
  type      String
  userId    String
  snapId    String
  createdAt DateTime @default(now())
  snap      Snap     @relation(fields: [snapId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, snapId])
  @@index([snapId])
  @@map("reactions")
}

model Comment {
  id           String        @id @default(cuid())
  content      String
  userId       String
  snapId       String
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  commentLikes CommentLike[]
  snap         Snap          @relation(fields: [snapId], references: [id], onDelete: Cascade)
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([snapId])
  @@index([createdAt])
  @@map("comments")
}

model CommentLike {
  id        String   @id @default(cuid())
  userId    String
  commentId String
  createdAt DateTime @default(now())
  comment   Comment  @relation(fields: [commentId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, commentId])
  @@index([commentId])
  @@map("comment_likes")
}

enum UserRole {
  USER
  ADMIN
}

model PushSubscription {
  id        String   @id @default(cuid())
  endpoint  String   @unique
  p256dh    String
  auth      String
  deviceId  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([deviceId])
  @@map("push_subscriptions")
}

/// Serverless-safe Telegram conversation flags (e.g. awaiting Snap code after /find).
model TelegramChatState {
  chatId       String   @id
  awaitingMode String?
  updatedAt    DateTime @updatedAt

  @@map("telegram_chat_states")
}

model TelegramAccount {
  id               String   @id @default(cuid())
  telegramUserId   String   @unique
  telegramUsername String?
  userId           String   @unique
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("telegram_accounts")
}

model TelegramLinkChallenge {
  id               String    @id @default(cuid())
  tokenHash        String    @unique
  telegramUserId   String
  telegramChatId   String?
  expiresAt        DateTime
  consumedAt       DateTime?
  linkedUserId     String?
  createdAt        DateTime  @default(now())

  @@index([telegramUserId, createdAt])
  @@map("telegram_link_challenges")
}

model TelegramUploadLog {
  id             String   @id @default(cuid())
  telegramUserId String
  createdAt      DateTime @default(now())

  @@index([telegramUserId, createdAt])
  @@map("telegram_upload_logs")
}
