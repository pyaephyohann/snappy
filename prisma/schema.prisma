generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model AccessCredential {
  id           String   @id @default(cuid())
  passcodeHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("access_credentials")
}

model AdminCredential {
  id           String   @id @default(cuid())
  passcodeHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("admin_credentials")
}

model User {
  id                 String             @id @default(cuid())
  name               String             @unique
  profileImage                  String
  profileImageSnapId            String?            @unique
  profilePhotoGalleryUnlockedAt DateTime?
  passcodeHash                  String?
  birthday                      DateTime?
  isActive           Boolean            @default(true)
  lastLoginAt        DateTime?
  role               UserRole           @default(USER)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  commentLikes       CommentLike[]
  comments           Comment[]
  reactions          Reaction[]
  snaps              Snap[]
  profileImageSnap   Snap?              @relation("UserProfileImage", fields: [profileImageSnapId], references: [id], onDelete: SetNull)
  telegramAccount              TelegramAccount?
  profilePhotoGalleryPayments  ProfilePhotoGalleryPayment[]
  uploadedSnaps                Snap[]              @relation("SnapUploadedBy")
  notifications                Notification[]      @relation("NotificationRecipient")
  sentNotifications            Notification[]      @relation("NotificationActor")
  pushSubscriptions            PushSubscription[]
  following                    UserFollow[]        @relation("UserFollows")
  followers                    UserFollow[]        @relation("UserFollowers")
  conversationsAsLow           Conversation[]      @relation("ConversationUserLow")
  conversationsAsHigh          Conversation[]      @relation("ConversationUserHigh")
  conversationParticipants     ConversationParticipant[]
  sentMessages                 Message[]           @relation("MessageSender")

  @@map("users")
}

model UserFollow {
  id          String   @id @default(cuid())
  followerId  String
  followingId String
  createdAt   DateTime @default(now())

  follower  User @relation("UserFollows", fields: [followerId], references: [id], onDelete: Cascade)
  following User @relation("UserFollowers", fields: [followingId], references: [id], onDelete: Cascade)

  @@unique([followerId, followingId])
  @@index([followerId, createdAt])
  @@index([followingId, createdAt])
  @@map("user_follows")
}

model Conversation {
  id             String                    @id @default(cuid())
  userLowId      String
  userHighId     String
  lastMessageAt  DateTime?
  createdAt      DateTime                  @default(now())
  updatedAt      DateTime                  @updatedAt
  userLow        User                      @relation("ConversationUserLow", fields: [userLowId], references: [id], onDelete: Cascade)
  userHigh       User                      @relation("ConversationUserHigh", fields: [userHighId], references: [id], onDelete: Cascade)
  participants   ConversationParticipant[]
  messages       Message[]

  @@unique([userLowId, userHighId])
  @@index([lastMessageAt])
  @@map("conversations")
}

model ConversationParticipant {
  id             String       @id @default(cuid())
  conversationId String
  userId         String
  lastReadAt     DateTime?
  createdAt      DateTime     @default(now())
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
  @@index([userId, conversationId])
  @@map("conversation_participants")
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  senderId       String
  content        String
  createdAt      DateTime     @default(now())
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender         User         @relation("MessageSender", fields: [senderId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt, id])
  @@index([conversationId, senderId, createdAt, id])
  @@map("messages")
}

model ProfilePhotoGalleryPayment {
  id        String   @id @default(cuid())
  userId    String
  method    String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("profile_photo_gallery_payments")
}

model Snap {
  id                String             @id @default(cuid())
  imageUrl          String
  publicId          String
  caption           String?
  userId            String
  uploadedById      String?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  comments          Comment[]
  reactions         Reaction[]
  heroCarouselSlide HeroCarouselSlide?
  user              User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  uploadedBy        User?              @relation("SnapUploadedBy", fields: [uploadedById], references: [id], onDelete: SetNull)
  profileImageUser  User?              @relation("UserProfileImage")
  notifications     Notification[]

  @@index([userId])
  @@index([uploadedById])
  @@index([createdAt])
  @@map("snaps")
}

model HeroCarouselConfig {
  id        String   @id @default("default")
  title     String?
  updatedAt DateTime @updatedAt

  @@map("hero_carousel_config")
}

model HeroCarouselSlide {
  id        String   @id @default(cuid())
  snapId    String   @unique
  sortOrder Int
  altText   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  snap      Snap     @relation(fields: [snapId], references: [id], onDelete: Cascade)

  @@index([sortOrder])
  @@map("hero_carousel_slides")
}

model Reaction {
  id        String   @id @default(cuid())
  type      String
  userId    String
  snapId    String
  createdAt DateTime @default(now())
  snap      Snap     @relation(fields: [snapId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, snapId])
  @@index([snapId])
  @@map("reactions")
}

model Comment {
  id           String        @id @default(cuid())
  content      String
  userId       String
  snapId       String
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  commentLikes CommentLike[]
  snap         Snap          @relation(fields: [snapId], references: [id], onDelete: Cascade)
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([snapId])
  @@index([createdAt])
  @@map("comments")
}

model CommentLike {
  id        String   @id @default(cuid())
  userId    String
  commentId String
  createdAt DateTime @default(now())
  comment   Comment  @relation(fields: [commentId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, commentId])
  @@index([commentId])
  @@map("comment_likes")
}

enum UserRole {
  USER
  ADMIN
}

model PushSubscription {
  id        String   @id @default(cuid())
  endpoint  String   @unique
  p256dh    String
  auth      String
  deviceId  String
  userId    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([deviceId])
  @@index([userId])
  @@map("push_subscriptions")
}

model Notification {
  id        String           @id @default(cuid())
  type      NotificationType
  userId    String
  actorId   String
  snapId    String?
  body      String?
  readAt    DateTime?
  createdAt DateTime         @default(now())
  user      User             @relation("NotificationRecipient", fields: [userId], references: [id], onDelete: Cascade)
  actor     User             @relation("NotificationActor", fields: [actorId], references: [id], onDelete: Cascade)
  snap      Snap?            @relation(fields: [snapId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([userId, readAt])
  @@map("notifications")
}

enum NotificationType {
  NEW_SNAP
  REACTION
  COMMENT
  BIRTHDAY
}

/// Serverless-safe Telegram conversation flags (e.g. /find-friends, /upload).
model TelegramChatState {
  chatId               String   @id
  awaitingMode         String?
  findFriendsFriendId  String?
  findFriendsOffset    Int      @default(0)
  updatedAt            DateTime @updatedAt

  @@map("telegram_chat_states")
}

model TelegramAccount {
  id               String   @id @default(cuid())
  telegramUserId   String   @unique
  telegramUsername String?
  userId           String   @unique
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("telegram_accounts")
}

model TelegramLinkChallenge {
  id               String    @id @default(cuid())
  tokenHash        String    @unique
  telegramUserId   String
  telegramChatId   String?
  expiresAt        DateTime
  consumedAt       DateTime?
  linkedUserId     String?
  createdAt        DateTime  @default(now())

  @@index([telegramUserId, createdAt])
  @@map("telegram_link_challenges")
}

model TelegramUploadLog {
  id             String   @id @default(cuid())
  telegramUserId String
  createdAt      DateTime @default(now())

  @@index([telegramUserId, createdAt])
  @@map("telegram_upload_logs")
}
