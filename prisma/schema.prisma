generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model AccessCredential {
  id           String   @id @default(cuid())
  passcodeHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("access_credentials")
}

model AdminCredential {
  id           String   @id @default(cuid())
  passcodeHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("admin_credentials")
}

model User {
  id                String             @id @default(cuid())
  name              String             @unique
  profileImage      String
  role              UserRole           @default(USER)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  commentLikes      CommentLike[]
  comments          Comment[]
  reactions         Reaction[]
  snaps             Snap[]
  notifications     Notification[]
  pushSubscriptions PushSubscription[]

  @@map("users")
}

model Snap {
  id                String             @id @default(cuid())
  imageUrl          String
  publicId          String
  caption           String?
  userId            String
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  comments          Comment[]
  reactions         Reaction[]
  heroCarouselSlide HeroCarouselSlide?
  user              User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
  @@map("snaps")
}

model HeroCarouselConfig {
  id        String   @id @default("default")
  title     String?
  updatedAt DateTime @updatedAt

  @@map("hero_carousel_config")
}

model HeroCarouselSlide {
  id        String   @id @default(cuid())
  snapId    String   @unique
  sortOrder Int
  altText   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  snap      Snap     @relation(fields: [snapId], references: [id], onDelete: Cascade)

  @@index([sortOrder])
  @@map("hero_carousel_slides")
}

model Reaction {
  id        String   @id @default(cuid())
  type      String
  userId    String
  snapId    String
  createdAt DateTime @default(now())
  snap      Snap     @relation(fields: [snapId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, snapId])
  @@index([snapId])
  @@map("reactions")
}

model Comment {
  id           String        @id @default(cuid())
  content      String
  userId       String
  snapId       String
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  commentLikes CommentLike[]
  snap         Snap          @relation(fields: [snapId], references: [id], onDelete: Cascade)
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([snapId])
  @@index([createdAt])
  @@map("comments")
}

model CommentLike {
  id        String   @id @default(cuid())
  userId    String
  commentId String
  createdAt DateTime @default(now())
  comment   Comment  @relation(fields: [commentId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, commentId])
  @@index([commentId])
  @@map("comment_likes")
}

enum UserRole {
  USER
  ADMIN
}

enum NotificationType {
  NEW_SNAP
}

model Notification {
  id              String           @id @default(cuid())
  recipientUserId String
  type            NotificationType
  title           String
  body            String
  readAt          DateTime?
  relatedUserId   String?
  relatedSnapId   String?
  targetUrl       String
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  recipient       User             @relation(fields: [recipientUserId], references: [id], onDelete: Cascade)

  @@index([recipientUserId, createdAt(sort: Desc)])
  @@index([recipientUserId, readAt])
  @@map("notifications")
}

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("push_subscriptions")
}
