generator client {
  provider      = "prisma-client"
  output        = "../generated/prisma"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model AccessCredential {
  id           String   @id @default(cuid())
  passcodeHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("access_credentials")
}

model AdminCredential {
  id           String   @id @default(cuid())
  passcodeHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("admin_credentials")
}

model User {
  id           String        @id @default(cuid())
  name         String        @unique
  profileImage String
  role         UserRole      @default(USER)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  commentLikes CommentLike[]
  comments     Comment[]
  reactions    Reaction[]
  snaps        Snap[]

  @@map("users")
}

model Snap {
  id        String     @id @default(cuid())
  imageUrl  String
  publicId  String
  caption   String?
  userId    String
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  comments  Comment[]
  reactions Reaction[]
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
  @@map("snaps")
}

model Reaction {
  id        String   @id @default(cuid())
  type      String
  userId    String
  snapId    String
  createdAt DateTime @default(now())
  snap      Snap     @relation(fields: [snapId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, snapId])
  @@index([snapId])
  @@map("reactions")
}

model Comment {
  id           String        @id @default(cuid())
  content      String
  userId       String
  snapId       String
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  commentLikes CommentLike[]
  snap         Snap          @relation(fields: [snapId], references: [id], onDelete: Cascade)
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([snapId])
  @@index([createdAt])
  @@map("comments")
}

model CommentLike {
  id        String   @id @default(cuid())
  userId    String
  commentId String
  createdAt DateTime @default(now())
  comment   Comment  @relation(fields: [commentId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, commentId])
  @@index([commentId])
  @@map("comment_likes")
}

enum UserRole {
  USER
  ADMIN
}
